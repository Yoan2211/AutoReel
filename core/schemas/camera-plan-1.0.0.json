{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "AutoReel M4 AutoCam plan 1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "module", "stage", "time_domain", "source", "output", "input_geometry", "engine", "policy", "shots", "summary", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "module": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"const": "M4"}, "version": {"const": "1.0.0"}}},
    "stage": {"const": "autocam"}, "time_domain": {"const": "SOURCE"},
    "source": {"type": "object", "additionalProperties": false, "required": ["manifest_path", "manifest_sha256", "smartedit_time_map_path", "smartedit_time_map_sha256", "media_path", "media_sha256"], "properties": {"manifest_path": {"type": "string"}, "manifest_sha256": {"$ref": "#/$defs/hash"}, "smartedit_time_map_path": {"type": "string"}, "smartedit_time_map_sha256": {"$ref": "#/$defs/hash"}, "media_path": {"type": "string"}, "media_sha256": {"$ref": "#/$defs/hash"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["width", "height", "aspect_ratio"], "properties": {"width": {"const": 1080}, "height": {"const": 1920}, "aspect_ratio": {"const": "9:16"}}},
    "input_geometry": {"type": "object", "additionalProperties": false, "required": ["encoded_width", "encoded_height", "display_width", "display_height", "rotation_degrees"], "properties": {"encoded_width": {"type": "integer", "minimum": 1}, "encoded_height": {"type": "integer", "minimum": 1}, "display_width": {"type": "integer", "minimum": 1}, "display_height": {"type": "integer", "minimum": 1}, "rotation_degrees": {"enum": [0,90,180,270]}}},
    "engine": {"type": "object", "additionalProperties": false, "required": ["detector", "detector_version", "device", "frame_provider"], "properties": {"detector": {"type": "string"}, "detector_version": {"type": "string"}, "device": {"enum": ["cpu","cuda"]}, "frame_provider": {"type": "string"}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["sample_interval_us", "output_width", "output_height", "device", "cpu_fallback", "smoothing_alpha", "lost_hold_us", "keyframe_interval_us", "center_change_threshold", "zoom_change_threshold", "natural_zoom_max", "hard_zoom_max", "headroom_ratio"], "properties": {"sample_interval_us": {"type": "integer", "minimum": 1}, "output_width": {"const": 1080}, "output_height": {"const": 1920}, "device": {"enum": ["auto", "cpu", "cuda"]}, "cpu_fallback": {"type": "boolean"}, "smoothing_alpha": {"type": "number", "minimum": 0, "maximum": 1}, "lost_hold_us": {"type": "integer", "minimum": 1}, "keyframe_interval_us": {"type": "integer", "minimum": 1}, "center_change_threshold": {"type": "number", "minimum": 0, "maximum": 1}, "zoom_change_threshold": {"type": "number", "minimum": 0, "maximum": 1}, "natural_zoom_max": {"type": "number", "minimum": 1, "maximum": 1.15}, "hard_zoom_max": {"type": "number", "minimum": 1, "maximum": 1.15}, "headroom_ratio": {"type": "number", "minimum": 0, "maximum": 1}}},
    "shots": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "time_domain", "source_start_us", "source_end_us", "keyframes"], "properties": {"id": {"type": "string"}, "time_domain": {"const": "SOURCE"}, "source_start_us": {"type": "integer"}, "source_end_us": {"type": "integer"}, "keyframes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_us", "center_x", "center_y", "zoom", "crop_x", "crop_y", "crop_width", "crop_height", "subject_track_ids", "predicted_track_ids", "warning"], "properties": {"source_us": {"type": "integer"}, "center_x": {"type": "number", "minimum": 0, "maximum": 1}, "center_y": {"type": "number", "minimum": 0, "maximum": 1}, "zoom": {"type": "number", "minimum": 1, "maximum": 1.15}, "crop_x": {"type": "integer", "minimum": 0}, "crop_y": {"type": "integer", "minimum": 0}, "crop_width": {"type": "integer", "minimum": 1}, "crop_height": {"type": "integer", "minimum": 1}, "subject_track_ids": {"type": "array", "items": {"type": "integer"}}, "predicted_track_ids": {"type": "array", "items": {"type": "integer"}}, "warning": {"type": ["string","null"]}}}}}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["source_interval_count", "frames_analyzed", "detections", "keyframes"], "properties": {"source_interval_count": {"type": "integer", "minimum": 0}, "frames_analyzed": {"type": "integer", "minimum": 0}, "detections": {"type": "integer", "minimum": 0}, "keyframes": {"type": "integer", "minimum": 0}}},
    "warnings": {"type": "array", "uniqueItems": true, "items": {"enum": ["CPU_FALLBACK", "NO_SUBJECT", "SUBJECTS_EXCEED_VERTICAL_FRAME", "NO_FRAMES_ANALYZED"]}}
  }, "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
