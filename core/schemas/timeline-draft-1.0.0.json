{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoReel M10 Timeline Compiler Pass A draft 1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "module", "stage", "time_domains", "source", "format", "tracks", "unmaterialized", "diagnostics", "summary"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "module": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"const": "M10"}, "version": {"const": "1.0.0"}}},
    "stage": {"const": "timeline_compiler_pass_a"},
    "time_domains": {"type": "object", "additionalProperties": false, "required": ["source", "cut", "timeline"], "properties": {"source": {"const": "SOURCE"}, "cut": {"const": "CUT"}, "timeline": {"const": "TIMELINE"}}},
    "source": {"type": "object", "additionalProperties": false,
      "required": ["media_info_path", "media_info_sha256", "smartedit_time_map_path", "smartedit_time_map_sha256", "edit_plan_path", "edit_plan_sha256", "camera_plan_path", "camera_plan_sha256", "visual_plan_path", "visual_plan_sha256", "sound_plan_path", "sound_plan_sha256", "music_plan_path", "music_plan_sha256", "assets_manifest_path", "assets_manifest_sha256"],
      "properties": {
        "media_info_path": {"type": "string"}, "media_info_sha256": {"$ref": "#/$defs/hash"},
        "smartedit_time_map_path": {"type": "string"}, "smartedit_time_map_sha256": {"$ref": "#/$defs/hash"},
        "edit_plan_path": {"type": "string"}, "edit_plan_sha256": {"$ref": "#/$defs/hash"},
        "camera_plan_path": {"type": "string"}, "camera_plan_sha256": {"$ref": "#/$defs/hash"},
        "visual_plan_path": {"type": "string"}, "visual_plan_sha256": {"$ref": "#/$defs/hash"},
        "sound_plan_path": {"type": "string"}, "sound_plan_sha256": {"$ref": "#/$defs/hash"},
        "music_plan_path": {"type": "string"}, "music_plan_sha256": {"$ref": "#/$defs/hash"},
        "assets_manifest_path": {"type": "string"}, "assets_manifest_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "format": {"type": "object", "additionalProperties": false, "required": ["width", "height", "aspect_ratio", "duration_us", "timeline_start_us"], "properties": {"width": {"const": 1080}, "height": {"const": 1920}, "aspect_ratio": {"const": "9:16"}, "duration_us": {"type": "integer", "minimum": 0}, "timeline_start_us": {"const": 0}}},
    "tracks": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/track"}},
    "unmaterialized": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["request_id", "origin_module", "origin_id", "status", "asset_id", "reason"], "properties": {"request_id": {"type": "string"}, "origin_module": {"enum": ["M5", "M7", "M8"]}, "origin_id": {"type": "string"}, "status": {"enum": ["REVIEW", "UNRESOLVED"]}, "asset_id": {"type": ["string", "null"]}, "reason": {"type": "string"}}}},
    "diagnostics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "severity", "origin_id", "reason"], "properties": {"code": {"type": "string"}, "severity": {"enum": ["WARNING", "ERROR"]}, "origin_id": {"type": ["string", "null"]}, "reason": {"type": "string"}}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["track_count", "event_count", "source_segment_count", "materialized_asset_event_count", "unmaterialized_count", "diagnostic_count"], "properties": {"track_count": {"const": 6}, "event_count": {"type": "integer", "minimum": 0}, "source_segment_count": {"type": "integer", "minimum": 0}, "materialized_asset_event_count": {"type": "integer", "minimum": 0}, "unmaterialized_count": {"type": "integer", "minimum": 0}, "diagnostic_count": {"type": "integer", "minimum": 0}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "track": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "index", "role", "events"], "properties": {"id": {"enum": ["V1", "V2", "V3", "A1", "A2", "A3"]}, "kind": {"enum": ["VIDEO", "AUDIO"]}, "index": {"type": "integer", "minimum": 1, "maximum": 3}, "role": {"enum": ["SOURCE_VIDEO", "VISUALS_BROLL", "RESERVED_GRAPHICS_CAPTIONS", "SOURCE_VOICE", "MUSIC", "SFX"]}, "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}}},
    "event": {"type": "object", "required": ["id", "type", "timeline_start_us", "timeline_end_us"], "properties": {
      "id": {"type": "string"}, "type": {"enum": ["SOURCE_VIDEO", "VISUAL_ASSET", "SOURCE_AUDIO", "MUSIC_ASSET", "SFX_ASSET"]},
      "origin_id": {"type": "string"}, "media_path": {"type": "string"}, "media_sha256": {"$ref": "#/$defs/hash"}, "stream_index": {"type": "integer", "minimum": 0},
      "asset_id": {"type": "string"}, "asset_path": {"type": "string"}, "asset_sha256": {"$ref": "#/$defs/hash"}, "asset_type": {"type": "string"},
      "source_start_us": {"type": "integer"}, "source_end_us": {"type": "integer"}, "source_time_us": {"type": "integer"}, "source_intervals": {"type": "array", "items": {"$ref": "#/$defs/source_interval"}},
      "cut_start_us": {"type": "integer", "minimum": 0}, "cut_end_us": {"type": "integer", "minimum": 0}, "cut_time_us": {"type": "integer", "minimum": 0},
      "timeline_start_us": {"type": "integer", "minimum": 0}, "timeline_end_us": {"type": "integer", "minimum": 1},
      "camera_keyframes": {"type": "array", "items": {"$ref": "#/$defs/camera_keyframe"}},
      "fade_in_us": {"type": "integer", "minimum": 0}, "fade_out_us": {"type": "integer", "minimum": 0}, "gain_db": {"type": "number", "minimum": -60, "maximum": 0},
      "level_regions": {"type": "array", "items": {"$ref": "#/$defs/level_region"}}
    }},
    "source_interval": {"type": "object", "additionalProperties": false, "required": ["source_start_us", "source_end_us"], "properties": {"source_start_us": {"type": "integer"}, "source_end_us": {"type": "integer"}}},
    "camera_keyframe": {"type": "object", "additionalProperties": false, "required": ["source_us", "cut_us", "timeline_us", "center_x", "center_y", "zoom", "crop_x", "crop_y", "crop_width", "crop_height", "subject_track_ids", "predicted_track_ids", "warning"], "properties": {"source_us": {"type": "integer"}, "cut_us": {"type": "integer", "minimum": 0}, "timeline_us": {"type": "integer", "minimum": 0}, "center_x": {"type": "number", "minimum": 0, "maximum": 1}, "center_y": {"type": "number", "minimum": 0, "maximum": 1}, "zoom": {"type": "number", "minimum": 1, "maximum": 1.15}, "crop_x": {"type": "integer", "minimum": 0}, "crop_y": {"type": "integer", "minimum": 0}, "crop_width": {"type": "integer", "minimum": 1}, "crop_height": {"type": "integer", "minimum": 1}, "subject_track_ids": {"type": "array", "items": {"type": "integer"}}, "predicted_track_ids": {"type": "array", "items": {"type": "integer"}}, "warning": {"type": ["string", "null"]}}},
    "level_region": {"type": "object", "additionalProperties": false, "required": ["cut_start_us", "cut_end_us", "timeline_start_us", "timeline_end_us", "source_intervals", "mode", "gain_db", "reason"], "properties": {"cut_start_us": {"type": "integer", "minimum": 0}, "cut_end_us": {"type": "integer", "minimum": 1}, "timeline_start_us": {"type": "integer", "minimum": 0}, "timeline_end_us": {"type": "integer", "minimum": 1}, "source_intervals": {"type": "array", "items": {"$ref": "#/$defs/source_interval"}}, "mode": {"enum": ["SPEECH_DUCK", "NO_SPEECH_LIFT", "SFX_PROTECTED", "STABLE_BASE"]}, "gain_db": {"type": "number", "minimum": -60, "maximum": 0}, "reason": {"type": "string"}}}
  }
}
