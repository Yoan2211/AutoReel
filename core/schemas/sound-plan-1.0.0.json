{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoReel M7 SoundDesign plan 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module", "stage", "source_time_domain", "target_time_domain", "source", "policy", "decisions", "summary", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "module": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"const": "M7"}, "version": {"const": "1.0.0"}}},
    "stage": {"const": "sounddesign"},
    "source_time_domain": {"const": "SOURCE"},
    "target_time_domain": {"const": "CUT"},
    "source": {"type": "object", "additionalProperties": false,
      "required": ["transcript_path", "transcript_sha256", "edit_plan_path", "edit_plan_sha256", "visual_plan_path", "visual_plan_sha256", "camera_plan_path", "camera_plan_sha256", "smartedit_time_map_path", "smartedit_time_map_sha256", "media_path", "media_sha256"],
      "properties": {
        "transcript_path": {"type": "string"}, "transcript_sha256": {"$ref": "#/$defs/hash"},
        "edit_plan_path": {"type": "string"}, "edit_plan_sha256": {"$ref": "#/$defs/hash"},
        "visual_plan_path": {"type": "string"}, "visual_plan_sha256": {"$ref": "#/$defs/hash"},
        "camera_plan_path": {"type": "string"}, "camera_plan_sha256": {"$ref": "#/$defs/hash"},
        "smartedit_time_map_path": {"type": "string"}, "smartedit_time_map_sha256": {"$ref": "#/$defs/hash"},
        "media_path": {"type": "string"}, "media_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "policy": {"type": "object", "additionalProperties": false,
      "required": ["minimum_gap_us", "conflict_window_us", "density_window_us", "maximum_sfx_per_window", "zoom_delta_threshold", "strong_passage_threshold", "proposal_threshold", "review_threshold"],
      "properties": {
        "minimum_gap_us": {"type": "integer", "minimum": 1}, "conflict_window_us": {"type": "integer", "minimum": 1},
        "density_window_us": {"type": "integer", "minimum": 1}, "maximum_sfx_per_window": {"type": "integer", "minimum": 1},
        "zoom_delta_threshold": {"type": "number", "minimum": 0, "maximum": 1}, "strong_passage_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "proposal_threshold": {"type": "number", "minimum": 0, "maximum": 1}, "review_threshold": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "decisions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "candidate_id", "event_kind", "type", "status", "source_time_us", "cut_time_us", "gain_db", "priority", "confidence", "score", "origin_ids", "reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^sound[0-9]{6,}$"}, "candidate_id": {"type": "string", "pattern": "^candidate[0-9]{6,}$"},
        "event_kind": {"enum": ["HOOK", "STRONG_PHRASE", "VISUAL_APPEARANCE", "SECTION_CHANGE", "ZOOM", "TRANSITION", "CONCEPT_EMPHASIS"]},
        "type": {"enum": ["SOFT_IMPACT", "POP", "CLICK", "WHOOSH", "SWOOSH", "RISER", "ACCENT", "NONE"]},
        "status": {"enum": ["PROPOSED", "REVIEW", "NONE"]},
        "source_time_us": {"type": "integer"}, "cut_time_us": {"type": "integer", "minimum": 0},
        "gain_db": {"type": ["number", "null"], "minimum": -60, "maximum": 0},
        "priority": {"enum": ["HIGH", "MEDIUM", "LOW"]}, "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1}, "origin_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "NONE"}}}, "then": {"properties": {"type": {"const": "NONE"}, "gain_db": {"type": "null"}}}},
        {"if": {"properties": {"status": {"enum": ["PROPOSED", "REVIEW"]}}}, "then": {"properties": {"type": {"enum": ["SOFT_IMPACT", "POP", "CLICK", "WHOOSH", "SWOOSH", "RISER", "ACCENT"]}, "gain_db": {"type": "number", "minimum": -60, "maximum": 0}}}}
      ]
    }},
    "summary": {"type": "object", "additionalProperties": false, "required": ["candidate_count", "proposed_count", "review_count", "none_count"], "properties": {
      "candidate_count": {"type": "integer", "minimum": 0}, "proposed_count": {"type": "integer", "minimum": 0},
      "review_count": {"type": "integer", "minimum": 0}, "none_count": {"type": "integer", "minimum": 0}
    }},
    "warnings": {"type": "array", "uniqueItems": true, "items": {"enum": ["NO_SPEECH_RECOGNIZED", "NO_SFX_SELECTED"]}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
